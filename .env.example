# Copy to .env only if you later add an environment-file loader.
SHA_MONITORING_INTERVAL_SECONDS=10
SHA_CPU_WARNING_PERCENT=85
SHA_MEMORY_WARNING_PERCENT=85
SHA_DISK_FREE_WARNING_PERCENT=10

# Optional OpenAI-backed diagnosis. Keep this key in your process environment,
# never commit a real key. The API sends diagnostic details only after consent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public Supabase project settings for per-user sign-in and MFA.
# These values are safe for browser use; never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
